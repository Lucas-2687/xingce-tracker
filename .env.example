# Choose a Turso libSQL database for this driver. Never prefix secrets with NEXT_PUBLIC_.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
# Run npm run password:hash, then paste the generated hash here.
APP_PASSWORD_HASH=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=
# Stable data namespace: keep this unchanged on future deployments.
APP_OWNER_ID=owner
APP_DISPLAY_NAME=我的行测轨迹
# Preview is disabled by default. Enable ONLY with a separate test database and credentials.
APP_PREVIEW_ENABLED=false
